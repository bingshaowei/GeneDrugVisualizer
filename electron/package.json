{
  "name": "gene-drug-electron",
  "version": "1.1.1",
  "description": "Electron app for gene-drug platform",
  "author": "Shaowei Bing",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "copy-frontend": "cd ../frontend && npm install && npm run build",
    "test": "node --test tests/*.test.js",
    "audit:security": "npm audit --audit-level=low"
  },
  "build": {
    "appId": "com.electron.gene-drug-electron",
    "productName": "GeneDrugApp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "runtime.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/app.py",
        "to": "backend/app.py"
      },
      {
        "from": "../backend/api.py",
        "to": "backend/api.py"
      },
      {
        "from": "../backend/data_service.py",
        "to": "backend/data_service.py"
      },
      {
        "from": "../backend/requirements.txt",
        "to": "backend/requirements.txt"
      },
      {
        "from": "../backend/data",
        "to": "backend/data"
      },
      {
        "from": "../frontend/build",
        "to": "backend/build"
      },
      {
        "from": "python-embedded",
        "to": "python-embedded"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signtoolOptions": {
        "sign": null
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@44.5.1": true
  }
}
