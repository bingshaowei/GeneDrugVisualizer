{
  "name": "gene-drug-electron",
  "version": "1.0.0",
  "description": "Electron app for gene-drug platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "copy-frontend": "cd ../frontend && npm install && npm run build",
    "test": "node --test tests/*.test.js"
  },
  "build": {
    "productName": "GeneDrugApp",
   "directories": {
     "output": "dist"
   },
    "electronDist": "./node_modules/electron/dist",
   "extraResources": [
      {
        "from": "../backend/app.py",
        "to": "backend/app.py"
      },
      {
        "from": "../backend/api.py",
        "to": "backend/api.py"
      },
      {
        "from": "../backend/data_service.py",
        "to": "backend/data_service.py"
      },
      {
        "from": "../backend/requirements.txt",
        "to": "backend/requirements.txt"
      },
      {
        "from": "../backend/data",
        "to": "backend/data"
      },
      {
        "from": "../frontend/build",
        "to": "backend/build"
      },
      {
        "from": "python-embedded",
        "to": "python-embedded"
      }
    ],
    "win": {
      "target": "nsis",
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^27.1.0",
    "electron-builder": "^23.6.0"
  }
}
